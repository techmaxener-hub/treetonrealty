# Filled in per broker by the provisioning pipeline -- never committed with
# real values. See control-plane/ broker_instances.secrets_ref.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key -- background/cron automation dispatch and the
# team-invite route (auth.admin.inviteUserByEmail) only. Bypasses RLS;
# never expose to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the automation cron endpoint checks (Authorization: Bearer
# <value>). Vercel Cron sends it automatically when set as an env var and
# referenced from vercel.json; anything else calling the endpoint must
# send the same header manually.
CRON_SECRET=

# WhatsApp send provider -- unset means dry-run (logs to console, engine
# still fully exercisable). One of: meta_cloud | generic_webhook
WHATSAPP_PROVIDER=

# meta_cloud provider (official WhatsApp Cloud API)
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=

# generic_webhook provider -- for providers like Interakt/Gupshup, or a
# translator you run yourself. Posts {to, message} as JSON.
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_API_KEY=

# SMTP -- email send provider. Unset means dry-run (logs to console).
# Works with any provider (Gmail, SES, SendGrid, Postmark, a broker's own
# mail server) without picking a vendor SDK.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
