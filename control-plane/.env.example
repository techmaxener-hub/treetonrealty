# This project's own control-plane Supabase project (never a broker's).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key -- the team-invite route and provisioning orchestrator
# only. Bypasses RLS; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Management API -- creates each broker's own Supabase project.
# Unset means the create_project provisioning step dry-runs (logs what it
# would do and fabricates a placeholder project ref so later steps have
# something to reference).
SUPABASE_MANAGEMENT_API_TOKEN=
SUPABASE_MANAGEMENT_ORG_ID=
SUPABASE_PROVISION_REGION=

# Vercel API -- deploys tenant-template and assigns each broker's
# subdomain. Unset means deploy_frontend/assign_domain dry-run.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
VERCEL_GIT_REPO=
PLATFORM_BASE_DOMAIN=
